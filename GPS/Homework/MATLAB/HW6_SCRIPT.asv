%% ASEN 5090 GPS/GNSS
%% Justin Le
%% HW6 Main Script
clc;clear;close all


%% Read in files
%% Read in files (loaded from a .mat cache after the first run, for speed)
cacheFile = 'HW6_data.mat';
if isfile(cacheFile)
    load(cacheFile, 'NISTrinexDataGPS', 'NYA2rinexDataGPS', 'satPRN', 'ephemeris');
else
    % NIST
    NISTrinexData = rinexread('NIST00USA_R_20262310000_01D_30S_MO.rnx');
    NISTrinexDataGPS = NISTrinexData.GPS;

    % NYA2
    NYA2rinexData = rinexread('NYA200NOR_R_20262310000_01D_30S_MO.rnx');
    NYA2rinexDataGPS = NYA2rinexData.GPS;

    % sp3 file
    sp3 = read_sp3('IGS0OPSFIN_20262310000_01D_15M_ORB.SP3'); % probably
    satPRN = extract_sp3_prn(sp3);

    % Ephemeris
    ephemeris = read_clean_GPSbroadcast('brdc2310.26n', true);

    save(cacheFile, 'NISTrinexDataGPS', 'NYA2rinexDataGPS', 'satPRN', 'ephemeris');
end

%% A priori locations
% NIST Priori
r_a_priori_NIST_ECEF = [-1288399.0601 -4721697.8747  4078626.5526];
r_a_priori_NYA2_ECEF  = [1202379.3100   252474.6543  6237786.5417];

NIST_ECEF = [-1288398.567 -4721696.932 4078625.350];

% get into LLA
lla_NIST = ecef2lla(r_a_priori_NIST_ECEF);
lla_NYA2 = ecef2lla(r_a_priori_NYA2_ECEF);

%% Compute transformation matrices
C_ECEF2ENU_NIST = ECEF2ENU(lla_NIST(1), lla_NIST(2));
C_ECEF2ENU_NYA2 = ECEF2ENU(lla_NYA2(1), lla_NYA2(2));

%% Looping through all satellites
% Compute, sat position, expected range, sat clock correction, relativity
% correctio, based on epehemeris and a priori

% Store results per satellite in a struct, satEph(PRN)
% for PRN = 1:32
%     satEph(PRN).PRN = PRN;
%     [satEph(PRN).health, satEph(PRN).satPos, satEph(PRN).satVel, satEph(PRN).satClkCorr] = eph2pvt2025(ephemeris, [satPRN(PRN).week_number satPRN(PRN).TOW_s], PRN);
% end

% Find single point solution just for NIST right now that NIST can see
PRN_list = unique(NISTrinexDataGPS.SatelliteID)';

for PRN = PRN_list
    PRNid = sprintf('PRN%d', PRN);
    [PIF.(PRNid), R1.(PRNid), EL.(PRNid), AZ.(PRNid), BSV.(PRNid), RELAT.(PRNid), TROP.(PRNid), SATPOS.(PRNid)] = singlepointsolution(PRN,NISTrinexDataGPS, ephemeris, r_a_priori_NIST_ECEF);
    time.(PRNid) = NISTrinexDataGPS.Time(NISTrinexDataGPS.SatelliteID == PRN); % time of each row
end
% TODO check for the correct iono corrections, zenith delay is hardcoded
% for NIST currently


%% Calculate and store prefit residuals
% Remove all satellites below 10 degrees elevation
for PRN = PRN_list
    PRNid = sprintf('PRN%d', PRN);
    el_mask = EL.(PRNid) < 10;
    PIF.(PRNid)(el_mask) = NaN;
    prefit.(PRNid) = PIF.(PRNid) - (R1.(PRNid) - BSV.(PRNid) - RELAT.(PRNid) + TROP.(PRNid));
end

%% Find all relevant parameters and correlate them to an epoch
gps_epochs = unique(NISTrinexDataGPS.Time);
for PRN = PRN_list
    PRNid = sprintf('PRN%d', PRN);
    for i = 1:length(time.(PRNid))
        if ~isnan(PIF.(PRNid)(i)) % Skip measurements below 10 deg and therefore skip nans
            epoch_id = sprintf('epoch%d', find(gps_epochs == time.(PRNid)(i)));
            epoch.(epoch_id).PRN.(PRNid) = PRN;
            epoch.(epoch_id).PIF.(PRNid) = PIF.(PRNid)(i);
            epoch.(epoch_id).R1.(PRNid) = R1.(PRNid)(i);
            epoch.(epoch_id).BSV.(PRNid) = BSV.(PRNid)(i);
            epoch.(epoch_id).RELAT.(PRNid) = RELAT.(PRNid)(i);
            epoch.(epoch_id).TROP.(PRNid) = TROP.(PRNid)(i);
            epoch.(epoch_id).SATPOS.(PRNid) = SATPOS.(PRNid)(i,:);
        end
    end
end

%% Least squares solution at each epoch
for k = 1:length(gps_epochs)
    epoch_id = sprintf('epoch%d', k);

    % PRNs in view and their satellite positions at this epoch
    epoch_PRN_list = cell2mat(struct2cell(epoch.(epoch_id).PRN))';
    satPos_epoch = cell2mat(struct2cell(epoch.(epoch_id).SATPOS));

    [sol.(epoch_id).G, sol.(epoch_id).dx_hat, sol.(epoch_id).delta_rho_post] = compute_least_point_solution(epoch_PRN_list, epoch.(epoch_id), satPos_epoch, r_a_priori_NIST_ECEF);
    sol.(epoch_id).dENU = C_ECEF2ENU_NIST*sol.(epoch_id).dx_hat(1:3);
end

