%% ASEN 5335 Aerospace Environment
%% Justin Le
%% HW3 Problem 4

clc; clear; close all

% Constants
qe = 1.602176634e-19; % C
kB = 1.380649e-23; % J/K
me = 9.1093837e-31; % kg
mi = 1.67262192e-27; % kg, H+ at GEO

% GEO plasma
n = 0.5e6; % cm^-3 -> m^-3
T = 5e6; % K, Te = Ti
kT = kB * T / qe; % thermal voltage [V]
fprintf('kT/q = %.1f V\n', kT);

% Thermal velocities [m/s]
ve = sqrt(3 * kB * T / me);
vi = sqrt(3 * kB * T / mi);

% Photocurrent (Eq. 28), surface normal to sun
Jph0 = 40e-6; % A/m^2
kTph = 2; % eV

% Current densities [A/m^2], A_i = A_e = A cancels out
Je_neg = @(V) -0.25*qe*n*ve*exp(V / kT); % Eq. 21, V < 0
Je_pos = @(V) -0.25*qe*n*ve*(1 + V / kT); % Eq. 22, V > 0
Ji_pos = @(V) 0.25*qe*n*vi*exp(-V / kT); % Eq. 24, V > 0
Ji_neg = @(V) 0.25*qe*n*vi*(1-V/kT); % Eq. 25, V < 0
Jph = @(V) Jph0*exp(-V / kTph); % Eq. 28, V > 0

% Shadow surface: dQ/dt = Ie + Ii = 0, V < 0
dQ_shadow = @(V) Je_neg(V) + Ji_neg(V);
V_shadow = fzero(dQ_shadow, [-1e5, 0]);
fprintf('Shadow potential = %.1f V (%.2f kTe)\n', V_shadow, V_shadow/kT);

% Sunlit surface: dQ/dt = Ie + Ii + Iph = 0, V > 0
dQ_sun = @(V) Je_pos(V) + Ji_pos(V) + Jph(V);
V_sun = fzero(dQ_sun, [0, 1e3]);
fprintf('Sunlit potential = %.2f V\n', V_sun);

% Differential charging
dV = V_sun - V_shadow;
fprintf('Potential difference = %.1f V\n', dV);
