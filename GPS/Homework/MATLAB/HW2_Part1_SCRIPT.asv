%% ASEN 5090 GPS/GNSS
%% Justin Le
%% HW2 Part 1 Main Script

clc; clear; close all

% Reading in the sp3 files
sp3 = read_sp3('IGS0OPSFIN_20262310000_01D_15M_ORB.SP3');

% Graphing PRN X,Y,Z [m] against time (0-24 hours)

% a.
% Select data for PRN5 from SP3
[week_number_prn, TOW_s_prn, TOW_hr_prn, time_epoch_s_prn, time_epoch_hr_prn, X_m_prn, Y_m_prn, Z_m_prn, clock_bias_us_prn, constellation_prn] = extract_sp3_prn(sp3, 5);

figure()
plot(time_epoch_hr_prn,X_m_prn,'LineWidth',1.5)
hold on
plot(time_epoch_hr_prn,Y_m_prn,'LineWidth',1.5)
hold on
plot(time_epoch_hr_prn,Z_m_prn,'LineWidth',1.5)
title(sprintf('PRN%02d X,Y,Z Over time', prn))
xlabel('Time [hrs]')
ylabel('Distance [m]')
grid on
hold on

% b. Using the almanac
[gps_ephem,gps_ephem_cell] = read_GPSyuma('YUMA231.alm.txt',2);


[health_prn,satPos_m_prn,satClkCorr_prn] = alm2pos(gps_ephem,[week_number_prn, TOW_s_prn] ,prn);

plot(TOW_s_prn, satPos_m_prn, 'LineWidth',1.5)
legend('X SP3','Y SP3','Z SP3', 'X YUMA','Y YUMA','Z YUMA')

% c. Plot residuals
residuals_prn = [satPos_m_prn(:,1)-X_m_prn,satPos_m_prn(:,2)-Y_m_prn,satPos_m_prn(:,3)-Z_m_prn];
figure()
plot(time_epoch_hr_prn,residuals_prn)
title('Difference Between SP3 and Almanac Results')
xlabel('Time [hr]')
ylabel('Difference [m]')
legend('X','Y','Z')
grid on

% TODO: Describe: yeah its stll pretty bad to be off by an order of 1000
% meters

% Export this for part 3.
X_PRN5 = [X_m_prn,Y_m_prn,Z_m_prn];
TOW_s_PRN5 = TOW_s_prn;
save("HW2Part1.mat", 'X_PRN5','TOW_s_PRN5')