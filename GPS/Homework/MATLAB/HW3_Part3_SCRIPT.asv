%% ASEN 5090 GPS/GNSS
%% Justin Le
%% HW3 Part 2 Main Script
clc;clear;close all

% Reading in rinex
rinexData = rinexread('NIST00USA_R_20262310000_01D_30S_MO.rnx');
rinexDataGPS = rinexData.GPS;

% Read in ephemeris
clean_GPSbroadcast = read_clean_GPSbroadcast('brdc2310.26n', true);

PRN_number = 5;
PRN_index = rinexDataGPS.SatelliteID == PRN_number;
PRN05_GPS_rinexData = rinexDataGPS(PRN_index,:);

[GPS_week, GPS_TOW] = utc2gpstime(PRN05_GPS_rinexData.Time,18);

[health,satPos,satVel,satClkCorr] = eph2pvt2025(clean_GPSbroadcast, [GPS_week GPS_TOW], 5);


NIST_ECEF = [-1288398.567 -4721696.932 4078625.350];

ephem_time_s = GPS_week.*604800 + GPS_TOW;
ephem_time_hr = ephem_time_s/3600;

[AZ_NIST, EL_NIST, RANGE_NIST] = compute_azelrange(NIST_ECEF, satPos);

gap_idx = [false; diff(ephem_time_s) > 1.5*median(diff(ephem_time_s))];
AZ_NIST(gap_idx) = NaN;
EL_NIST(gap_idx) = NaN;
RANGE_NIST(gap_idx) = NaN;

figure()
plot(PRN05_GPS_rinexData.Time, AZ_NIST, 'LineWidth', 1.5)
grid on
xlabel('Time (UTC)')
ylabel('Azimuth (deg)')
title(sprintf('PRN %d Azimuth from NIST', PRN_number))

figure()
plot(PRN05_GPS_rinexData.Time, EL_NIST, 'LineWidth', 1.5)
grid on
xlabel('Time (UTC)')
ylabel('Elevation (deg)')
title(sprintf('PRN %d Elevation from NIST', PRN_number))

figure()
plot(PRN05_GPS_rinexData.Time, RANGE_NIST, 'LineWidth', 1.5)
grid on
xlabel('Time (UTC)')
ylabel('Range (m)')
title(sprintf('PRN %d Range from NIST', PRN_number))



function [week_number, tow] = utc2gpstime(utc_datetime, leap_seconds)
% Converts utc format to gps accounting for leapseconds as well, currently
% there are 18 leap seconds for GPS vs UTC.

    gps_epoch = datetime(1980,1,6,0,0,0);
    gps_datetime = utc_datetime + seconds(leap_seconds);

    seconds_since_gps_epoch = seconds(gps_datetime - gps_epoch);

    week_number = floor(seconds_since_gps_epoch/604800);
    tow = seconds_since_gps_epoch - week_number*604800;
end
