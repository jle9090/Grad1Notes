%% ASEN 5090 GPS/GNSS
%% Justin Le
%% HW6 Main Script
clc;clear;close all


%% Read in files
%% Read in files (loaded from a .mat cache after the first run, for speed)
cacheFile = 'HW6_data.mat';
if isfile(cacheFile)
    load(cacheFile, 'NISTrinexDataGPS', 'NYA2rinexDataGPS', 'satPRN', 'ephemeris');
else
    % NIST
    NISTrinexData = rinexread('NIST00USA_R_20262310000_01D_30S_MO.rnx');
    NISTrinexDataGPS = NISTrinexData.GPS;

    % NYA2
    NYA2rinexData = rinexread('NYA200NOR_R_20262310000_01D_30S_MO.rnx');
    NYA2rinexDataGPS = NYA2rinexData.GPS;

    % sp3 file
    sp3 = read_sp3('IGS0OPSFIN_20262310000_01D_15M_ORB.SP3'); % probably
    satPRN = extract_sp3_prn(sp3);

    % Ephemeris
    ephemeris = read_clean_GPSbroadcast('brdc2310.26n', true);

    save(cacheFile, 'NISTrinexDataGPS', 'NYA2rinexDataGPS', 'satPRN', 'ephemeris');
end

%% A priori locations
% NIST Priori
r_a_priori_NIST_ECEF = [-1288399.0601 -4721697.8747  4078626.5526];
r_a_priori_NYA2_ECEF  = [1202379.3100   252474.6543  6237786.5417];

% Zenith delay approximations at each site.
zenith_delay_NIST = 2;
zenith_delay_NYA2 = 2.36;

% get into LLA
lla_NIST = ecef2lla(r_a_priori_NIST_ECEF);
lla_NYA2 = ecef2lla(r_a_priori_NYA2_ECEF);

% Convert a priori to ENU
r_a_priori_NIST_ENU = ECEF2ENU(lla_NIST(1),lla_NIST(2))*r_a_priori_NIST_ECEF';
r_a_priori_NYA2_ENU = ECEF2ENU(lla_NYA2(1),lla_NYA2(2))*r_a_priori_NYA2_ECEF';

%% Compute transformation matrices
C_ECEF2ENU_NIST = ECEF2ENU(lla_NIST(1), lla_NIST(2));
C_ECEF2ENU_NYA2 = ECEF2ENU(lla_NYA2(1), lla_NYA2(2));

%% Remove observations before each satellite's first broadcast ephemeris
% eph2pvt2025 can't compute these (NYA2 sees PRN 29 before its first
% ephemeris at 02:00), so drop them
first_eph_time = zeros(32,1);
for PRN = 1:32
    eph_index = ephemeris(:,1) == PRN;
    first_eph_time(PRN) = min(ephemeris(eph_index,19)*604800 + ephemeris(eph_index,17));
end

% NIST
[week_NIST, tow_NIST] = utc2gpstime(NISTrinexDataGPS.Time);
has_eph_NIST = week_NIST*604800 + tow_NIST >= first_eph_time(NISTrinexDataGPS.SatelliteID);
NISTrinexDataGPS = NISTrinexDataGPS(has_eph_NIST,:);

% NYA2
[week_NYA2, tow_NYA2] = utc2gpstime(NYA2rinexDataGPS.Time);
has_eph_NYA2 = week_NYA2*604800 + tow_NYA2 >= first_eph_time(NYA2rinexDataGPS.SatelliteID);
NYA2rinexDataGPS = NYA2rinexDataGPS(has_eph_NYA2,:);

%% Looping through all satellites
% Compute, sat position, expected range, sat clock correction, relativity
% correctio, based on epehemeris and a priori

% Store results per satellite in a struct, satEph(PRN)
% for PRN = 1:32
%     satEph(PRN).PRN = PRN;
%     [satEph(PRN).health, satEph(PRN).satPos, satEph(PRN).satVel, satEph(PRN).satClkCorr] = eph2pvt2025(ephemeris, [satPRN(PRN).week_number satPRN(PRN).TOW_s], PRN);
% end

% Find single point solution for each satellite NIST can see
PRN_list_NIST = unique(NISTrinexDataGPS.SatelliteID)';

for PRN_NIST = PRN_list_NIST
    PRNid_NIST = sprintf('PRN%d', PRN_NIST);
    [PIF_NIST.(PRNid_NIST), R1_NIST.(PRNid_NIST), EL_NIST.(PRNid_NIST), AZ_NIST.(PRNid_NIST), BSV_NIST.(PRNid_NIST), RELAT_NIST.(PRNid_NIST), TROP_NIST.(PRNid_NIST), SATPOS_NIST.(PRNid_NIST)] = singlepointsolution(PRN_NIST,NISTrinexDataGPS, ephemeris, r_a_priori_NIST_ECEF, zenith_delay_NIST);
    time_NIST.(PRNid_NIST) = NISTrinexDataGPS.Time(NISTrinexDataGPS.SatelliteID == PRN_NIST); % time of each row
end
% TODO check for the correct iono corrections, zenith delay is hardcoded
% for NIST currently

% Find single point solution for each satellite NYA2 can see
PRN_list_NYA2 = unique(NYA2rinexDataGPS.SatelliteID)';

for PRN_NYA2 = PRN_list_NYA2
    PRNid_NYA2 = sprintf('PRN%d', PRN_NYA2);
    [PIF_NYA2.(PRNid_NYA2), R1_NYA2.(PRNid_NYA2), EL_NYA2.(PRNid_NYA2), AZ_NYA2.(PRNid_NYA2), BSV_NYA2.(PRNid_NYA2), RELAT_NYA2.(PRNid_NYA2), TROP_NYA2.(PRNid_NYA2), SATPOS_NYA2.(PRNid_NYA2)] = singlepointsolution(PRN_NYA2,NYA2rinexDataGPS, ephemeris, r_a_priori_NYA2_ECEF, zenith_delay_NYA2);
    time_NYA2.(PRNid_NYA2) = NYA2rinexDataGPS.Time(NYA2rinexDataGPS.SatelliteID == PRN_NYA2); % time of each row
end

%% Calculate and store prefit residuals
% Remove all satellites below 10 degrees elevation
% NIST
for PRN_NIST = PRN_list_NIST
    PRNid_NIST = sprintf('PRN%d', PRN_NIST);
    el_mask_NIST = EL_NIST.(PRNid_NIST) < 10;
    PIF_NIST.(PRNid_NIST)(el_mask_NIST) = NaN;
    prefit_NIST.(PRNid_NIST) = PIF_NIST.(PRNid_NIST) - (R1_NIST.(PRNid_NIST) - BSV_NIST.(PRNid_NIST) - RELAT_NIST.(PRNid_NIST) + TROP_NIST.(PRNid_NIST));
end

% NYA2
for PRN_NYA2 = PRN_list_NYA2
    PRNid_NYA2 = sprintf('PRN%d', PRN_NYA2);
    el_mask_NYA2 = EL_NYA2.(PRNid_NYA2) < 10;
    PIF_NYA2.(PRNid_NYA2)(el_mask_NYA2) = NaN;
    prefit_NYA2.(PRNid_NYA2) = PIF_NYA2.(PRNid_NYA2) - (R1_NYA2.(PRNid_NYA2) - BSV_NYA2.(PRNid_NYA2) - RELAT_NYA2.(PRNid_NYA2) + TROP_NYA2.(PRNid_NYA2));
end

%% Find all relevant parameters and correlate them to an epoch
% NIST
gps_epochs_NIST = unique(NISTrinexDataGPS.Time);
for PRN_NIST = PRN_list_NIST
    PRNid_NIST = sprintf('PRN%d', PRN_NIST);
    for i = 1:length(time_NIST.(PRNid_NIST))
        if ~isnan(PIF_NIST.(PRNid_NIST)(i)) % Skip measurements below 10 deg and therefore skip nans
            epoch_id_NIST = sprintf('epoch%d', find(gps_epochs_NIST == time_NIST.(PRNid_NIST)(i)));
            epoch_NIST.(epoch_id_NIST).PRN.(PRNid_NIST) = PRN_NIST;
            epoch_NIST.(epoch_id_NIST).PIF.(PRNid_NIST) = PIF_NIST.(PRNid_NIST)(i);
            epoch_NIST.(epoch_id_NIST).R1.(PRNid_NIST) = R1_NIST.(PRNid_NIST)(i);
            epoch_NIST.(epoch_id_NIST).BSV.(PRNid_NIST) = BSV_NIST.(PRNid_NIST)(i);
            epoch_NIST.(epoch_id_NIST).RELAT.(PRNid_NIST) = RELAT_NIST.(PRNid_NIST)(i);
            epoch_NIST.(epoch_id_NIST).TROP.(PRNid_NIST) = TROP_NIST.(PRNid_NIST)(i);
            epoch_NIST.(epoch_id_NIST).SATPOS.(PRNid_NIST) = SATPOS_NIST.(PRNid_NIST)(i,:);
        end
    end
end

% NYA2
gps_epochs_NYA2 = unique(NYA2rinexDataGPS.Time);
for PRN_NYA2 = PRN_list_NYA2
    PRNid_NYA2 = sprintf('PRN%d', PRN_NYA2);
    for i = 1:length(time_NYA2.(PRNid_NYA2))
        if ~isnan(PIF_NYA2.(PRNid_NYA2)(i)) % Skip measurements below 10 deg and therefore skip nans
            epoch_id_NYA2 = sprintf('epoch%d', find(gps_epochs_NYA2 == time_NYA2.(PRNid_NYA2)(i)));
            epoch_NYA2.(epoch_id_NYA2).PRN.(PRNid_NYA2) = PRN_NYA2;
            epoch_NYA2.(epoch_id_NYA2).PIF.(PRNid_NYA2) = PIF_NYA2.(PRNid_NYA2)(i);
            epoch_NYA2.(epoch_id_NYA2).R1.(PRNid_NYA2) = R1_NYA2.(PRNid_NYA2)(i);
            epoch_NYA2.(epoch_id_NYA2).BSV.(PRNid_NYA2) = BSV_NYA2.(PRNid_NYA2)(i);
            epoch_NYA2.(epoch_id_NYA2).RELAT.(PRNid_NYA2) = RELAT_NYA2.(PRNid_NYA2)(i);
            epoch_NYA2.(epoch_id_NYA2).TROP.(PRNid_NYA2) = TROP_NYA2.(PRNid_NYA2)(i);
            epoch_NYA2.(epoch_id_NYA2).SATPOS.(PRNid_NYA2) = SATPOS_NYA2.(PRNid_NYA2)(i,:);
        end
    end
end

%% Least squares solution at each epoch
% NIST
for i = 1:length(gps_epochs_NIST)
    epoch_id_NIST = sprintf('epoch%d', i);

    % Need to convert to vectors
    epoch_PRN_list_NIST = cell2mat(struct2cell(epoch_NIST.(epoch_id_NIST).PRN))';
    satPos_epoch_NIST = cell2mat(struct2cell(epoch_NIST.(epoch_id_NIST).SATPOS));

    % Find G matrix, correction vector, post fit residuals
    [sol_NIST.(epoch_id_NIST).G, sol_NIST.(epoch_id_NIST).dx_hat, sol_NIST.(epoch_id_NIST).delta_rho_post] = compute_least_point_solution(epoch_PRN_list_NIST, epoch_NIST.(epoch_id_NIST), satPos_epoch_NIST, r_a_priori_NIST_ECEF);

    % Calculate relative solutions in ENU frame
    sol_NIST.(epoch_id_NIST).dx_hat_ENU = ECEF2ENU(lla_NIST(1), lla_NIST(2))*sol_NIST.(epoch_id_NIST).dx_hat(1:3);
    sol_NIST.(epoch_id_NIST).relative_position = r_a_priori_NIST_ENU - sol_NIST.(epoch_id_NIST).dx_hat_ENU;

    % Solving for ENU Dops
    R_tilde = blkdiag(ECEF2ENU(lla_NIST(1), lla_NIST(2)), 1); % accounting for clock bias part
    sol_NIST.(epoch_id_NIST).G_ENU = sol_NIST.(epoch_id_NIST).G*R_tilde';
    sol_NIST.(epoch_id_NIST).H_ENU = inv(sol_NIST.(epoch_id_NIST).G_ENU'*sol_NIST.(epoch_id_NIST).G_ENU);
    sol_NIST.(epoch_id_NIST).EDOP = sqrt(sol_NIST.(epoch_id_NIST).H_ENU(1,1));
    sol_NIST.(epoch_id_NIST).NDOP = sqrt(sol_NIST.(epoch_id_NIST).H_ENU(2,2));
    sol_NIST.(epoch_id_NIST).VDOP = sqrt(sol_NIST.(epoch_id_NIST).H_ENU(3,3));

end

% NYA2
for i = 1:length(gps_epochs_NYA2)
    epoch_id_NYA2 = sprintf('epoch%d', i);

    % Need to convert to vectors
    epoch_PRN_list_NYA2 = cell2mat(struct2cell(epoch_NYA2.(epoch_id_NYA2).PRN))';
    satPos_epoch_NYA2 = cell2mat(struct2cell(epoch_NYA2.(epoch_id_NYA2).SATPOS));

    % Find G matrix, correction vector, post fit residuals
    [sol_NYA2.(epoch_id_NYA2).G, sol_NYA2.(epoch_id_NYA2).dx_hat, sol_NYA2.(epoch_id_NYA2).delta_rho_post] = compute_least_point_solution(epoch_PRN_list_NYA2, epoch_NYA2.(epoch_id_NYA2), satPos_epoch_NYA2, r_a_priori_NYA2_ECEF);
    
    % Calculate relative solutions in ENU frame
    sol_NYA2.(epoch_id_NYA2).dx_hat_ENU = ECEF2ENU(lla_NYA2(1), lla_NYA2(2))*sol_NYA2.(epoch_id_NYA2).dx_hat(1:3);
    sol_NYA2.(epoch_id_NYA2).relative_position = r_a_priori_NYA2_ENU - sol_NYA2.(epoch_id_NYA2).dx_hat_ENU;
    
    R_tilde = blkdiag(ECEF2ENU(lla_NYA2(1), lla_NYA2(2)), 1); % accounting for clock bias part
    sol_NYA2.(epoch_id_NYA2).G_ENU = sol_NYA2.(epoch_id_NYA2).G*R_tilde';

    % Solving for ENU Dops
    R_tilde = blkdiag(ECEF2ENU(lla_NYA2(1), lla_NYA2(2)), 1); % accounting for clock bias part
    sol_NIST.(epoch_id_NYA2).G_ENU = sol_NIST.(epoch_id_NYA2).G*R_tilde';
    sol_NIST.(epoch_id_NYA2).H_ENU = inv(sol_NYA2.(epoch_id_NIST).G_ENU'*sol_NYA2.(epoch_id_NIST).G_ENU);
    sol_NIST.(epoch_id_NYA2).EDOP = sqrt(sol_NYA2.(epoch_id_NIST).H_ENU(1,1));
    sol_NIST.(epoch_id_NYA2).NDOP = sqrt(sol_NYA2.(epoch_id_NIST).H_ENU(2,2));
    sol_NIST.(epoch_id_NYA2).VDOP = sqrt(sol_NYA2.(epoch_id_NIST).H_ENU(3,3));

end

%% Plot NIST solution vs time
% Convert struct into arrays
NIST_relative_position = zeros(3,1);
for i = 1:length(gps_epochs_NIST)
    epoch_id_NIST = sprintf('epoch%d', i);
    NIST_relative_position(:,i) = sol_NIST.(epoch_id_NIST).relative_position;
end

figure()
xlabel('Time')
ylabel('Relative Position')
title('NIST Relative Position')
subplot(3,1,1)
plot(gps_epochs_NIST, NIST_relative_position(1,:)')
ylabel('East')
grid minor
subplot(3,1,2)
ylabel('North')
plot(gps_epochs_NIST, NIST_relative_position(2,:)')
grid minor
subplot(3,1,3)
ylabel('Up')
plot(gps_epochs_NIST, NIST_relative_position(3,:)')
grid minor